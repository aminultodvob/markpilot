# =============================================================================
# MarkPilot - PRODUCTION environment reference
# =============================================================================
#
# This file is documentation, not a file you deploy. Neither Render nor Vercel
# reads a committed .env: each one has its own environment-variable UI, and
# committing real values would put them in git history. Copy the values from
# the relevant section into the matching dashboard.
#
# The examples use the two live deployments:
#
#   Converter (Render)  https://markpilot-0sic.onrender.com
#   Web app              https://markpilot.replyot.com  (custom domain on Vercel)
#
# Replace both with your own URLs.
#
# -----------------------------------------------------------------------------
# WHY THE BROWSER TALKS TO RENDER DIRECTLY
# -----------------------------------------------------------------------------
# Self-hosted, the browser calls the Next.js app and Next proxies to a private
# converter. That is the better architecture and it is still the default.
#
# It cannot work on Vercel's free tier. A Vercel serverless function accepts a
# request body of at most 4.5 MB, so a proxied upload of any real document
# fails there - no timeout or code change gets around a platform limit.
#
# So on Vercel we set NEXT_PUBLIC_CONVERTER_URL and the browser uploads
# straight to Render. The trade-off is that the converter is publicly
# reachable, which is why CORS and rate limiting below are load-bearing rather
# than decorative.
#
#   Browser ──upload──> Render converter (public, CORS-restricted)
#      │
#      └──page──────> Vercel web app
#
# =============================================================================


# =============================================================================
# 1. RENDER - converter service
#    Dashboard → your service → Environment
#    (Or let render.yaml set all of this except CORS_ORIGINS.)
# =============================================================================

APP_ENV=production
LOG_LEVEL=INFO

# --- Who may call this service ----------------------------------------------
# REQUIRED. Without your web app's exact origin here, the browser's request is
# blocked by CORS and the app appears broken with no server-side error.
# Comma-separated, scheme included, no trailing slash.
CORS_ORIGINS=https://markpilot.replyot.com,https://markpilot-black.vercel.app

# Optional: allows Vercel's generated preview domains. Anchor it at both ends
# (^...$) or it will also match a host like
# https://markpilot-x.vercel.app.attacker.com
CORS_ORIGIN_REGEX=^https://markpilot-[a-z0-9-]+\.vercel\.app$

# Render terminates TLS and sets X-Forwarded-For, so trust it here - otherwise
# every request looks like it came from Render's proxy and the rate limiter
# treats the whole internet as one client.
TRUST_PROXY_HEADERS=true

# --- Limits, sized for the free plan's 512 MB / shared CPU ------------------
# OCR is the memory-hungry part: one 300-DPI page is a ~25 MB bitmap before
# Tesseract's own working set. These values are what keep the free instance
# from being OOM-killed mid-conversion.
MAX_FILE_SIZE_MB=15
MAX_TOTAL_UPLOAD_MB=40
MAX_FILES_PER_JOB=8

MAX_ARCHIVE_SIZE_MB=20
MAX_ARCHIVE_FILES=30
MAX_ARCHIVE_UNCOMPRESSED_MB=80

# One at a time. Two concurrent OCR jobs will not fit in 512 MB.
MAX_CONCURRENT_CONVERSIONS=1
MAX_CONVERSION_TIME_SECONDS=120
MAX_OUTPUT_CHARACTERS=1500000

# --- Sessions ---------------------------------------------------------------
# Results are held in memory, so a shorter TTL matters more on a small box.
SESSION_TTL_MINUTES=15
CLEANUP_INTERVAL_SECONDS=60
# Must be writable and outside any web root. /var/tmp is correct in the image.
WORKSPACE_ROOT=/var/tmp/markpilot

# --- OCR --------------------------------------------------------------------
OCR_ENABLED=true
OCR_LANGUAGES=eng+ben
# 200 DPI still reads accurately and roughly halves the bitmap versus 300.
OCR_DPI=200
OCR_MAX_PAGES=20
OCR_PDF_TEXT_THRESHOLD_CHARS_PER_PAGE=100
OCR_LOW_CONFIDENCE_THRESHOLD=70

# Do NOT set TESSERACT_CMD or TESSDATA_PREFIX. The Docker image installs
# Tesseract with the eng and ben packs on the default path; overriding these
# with Windows paths is a common way to break OCR in production.
# TESSERACT_CMD=
# TESSDATA_PREFIX=

# --- Abuse protection -------------------------------------------------------
# The converter is public in this setup, so these are the real defence.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_JOBS_PER_HOUR=30
RATE_LIMIT_UPLOADS_MB_PER_HOUR=150

# Third-party MarkItDown plugins run arbitrary code against untrusted uploads.
MARKITDOWN_PLUGINS_ENABLED=false

# Optional vision OCR. Leave disabled unless you intend to send page images to
# a third party, and mark the key as secret in the dashboard.
VISION_OCR_ENABLED=false
# VISION_API_BASE_URL=https://api.openai.com/v1
# VISION_API_KEY=
# VISION_MODEL=


# =============================================================================
# 2. VERCEL - web app
#    Project → Settings → Environment Variables
#    Apply to Production, Preview and Development.
# =============================================================================

# REQUIRED on Vercel. Makes the browser upload straight to Render, bypassing
# the 4.5 MB serverless body limit. NEXT_PUBLIC_ means it is compiled into the
# client bundle, so it must be a public URL and must never hold a secret.
# No trailing slash.
NEXT_PUBLIC_CONVERTER_URL=https://markpilot-0sic.onrender.com

# Canonical URL for metadata, Open Graph and sitemap.
NEXT_PUBLIC_SITE_URL=https://markpilot.replyot.com

# Only used by the same-origin proxy route, which is the self-hosted path.
# Harmless to set on Vercel, and it keeps the proxy working as a fallback.
CONVERTER_API_URL=https://markpilot-0sic.onrender.com

# Do NOT set NEXT_OUTPUT_STANDALONE on Vercel. Standalone output replaces
# per-route serverless functions with a single server bundle, and the symptom
# is that static pages load while every API route returns 404. Vercel is
# detected automatically, so this stays off there regardless.


# =============================================================================
# 3. SELF-HOSTED / DOCKER COMPOSE
#    Here the converter stays private and Next proxies to it, so there is no
#    4.5 MB limit and no public backend.
# =============================================================================

# NEXT_PUBLIC_CONVERTER_URL=          # leave EMPTY to use the private proxy
# CONVERTER_API_URL=http://converter:8000
# NEXT_PUBLIC_SITE_URL=https://your-domain.example
# NEXT_OUTPUT_STANDALONE=true         # smaller runtime image
# CORS_ORIGINS=                       # empty: the browser never calls it
# TRUST_PROXY_HEADERS=true            # only behind a proxy you control
