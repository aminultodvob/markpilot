# MarkPilot - environment configuration
# Copy to .env and adjust. Never commit a real .env.

# --- Environment ------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# Origins allowed to call the converter API directly. In production the browser
# talks to the Next.js app, which proxies to the converter over the internal
# network, so this stays tight.
CORS_ORIGINS=http://localhost:3000

# Only enable behind a reverse proxy you control. Otherwise any client can
# spoof X-Forwarded-For and evade rate limiting.
TRUST_PROXY_HEADERS=false

# --- Upload limits ----------------------------------------------------------
MAX_FILE_SIZE_MB=50
MAX_TOTAL_UPLOAD_MB=200
MAX_FILES_PER_JOB=20

# --- Archive limits (zip bomb / zip slip defence) ---------------------------
MAX_ARCHIVE_SIZE_MB=100
MAX_ARCHIVE_FILES=100
MAX_ARCHIVE_UNCOMPRESSED_MB=400
MAX_ARCHIVE_COMPRESSION_RATIO=200
MAX_ARCHIVE_DEPTH=1

# --- Conversion -------------------------------------------------------------
MAX_CONVERSION_TIME_SECONDS=300
MAX_CONCURRENT_CONVERSIONS=4

# MarkItDown discovers third-party plugins through the "markitdown.plugin"
# entry-point group. That is arbitrary code running against untrusted uploads,
# so it is off unless you have audited every installed plugin.
MARKITDOWN_PLUGINS_ENABLED=false

# --- Sessions ---------------------------------------------------------------
SESSION_TTL_MINUTES=30
CLEANUP_INTERVAL_SECONDS=120
# Defaults to <system temp>/markpilot. Must NOT be inside a web root.
# WORKSPACE_ROOT=/tmp/markpilot

# --- OCR --------------------------------------------------------------------
OCR_ENABLED=true
# Tesseract language packs to use. "eng+ben" covers English and Bengali.
OCR_LANGUAGES=eng+ben
OCR_DPI=300
OCR_MAX_PAGES=100
# A PDF page yielding fewer characters than this is treated as image-only and
# routed to OCR.
OCR_PDF_TEXT_THRESHOLD_CHARS_PER_PAGE=100
# Mean word confidence (0-100) below which the result carries a quality warning.
OCR_LOW_CONFIDENCE_THRESHOLD=70

# Only needed when the binary or language data is not on the default path.
# On Windows, typically:
#   TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
#   TESSDATA_PREFIX=./services/converter/tessdata
# TESSERACT_CMD=
# TESSDATA_PREFIX=

# --- Optional vision OCR provider -------------------------------------------
# Entirely optional. OCR works locally via Tesseract without any of this.
# The key is read server-side only and is never sent to the browser.
VISION_OCR_ENABLED=false
# VISION_API_BASE_URL=https://api.openai.com/v1
# VISION_API_KEY=
# VISION_MODEL=

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_JOBS_PER_HOUR=40
RATE_LIMIT_UPLOADS_MB_PER_HOUR=500

# --- Web app ----------------------------------------------------------------
# Internal URL of the converter service, used by the Next.js server only.
CONVERTER_API_URL=http://localhost:8000
# Public site URL, used for canonical links and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
